ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://dealflow:dealflow@postgres:5432/dealflow
REDIS_URL=redis://redis:6379/0

# Comma/JSON list of allowed CORS origins for the API.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Clerk auth (required in production). JWKS URL + issuer enable JWT verification.
# CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
# CLERK_AUDIENCE=
